# Format : postgresql://USER:MOT_DE_PASSE@HOST:PORT/NOM_BASE?schema=public
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/coccinelledb?schema=public"
APP_NAME=Coccinelle

# --- Email SMTP (aligné Eteyelo / Hostinger) ---
# Préférer SMTP_* ; EMAIL_* reste supporté en alias (mailer).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@votredomaine.com
SMTP_PASS=votre_mot_de_passe_smtp
MAIL_FROM="Coccinelle <noreply@votredomaine.com>"

# Alias legacy (Gmail, etc.) — optionnel si SMTP_* est renseigné
# EMAIL_USER=your_smtp_username
# EMAIL_PASS=your_smtp_password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_FROM="Coccinelle <noreply@votredomaine.com>"

