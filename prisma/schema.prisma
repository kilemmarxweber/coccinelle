
generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum RoleFamille {
  CHEF
  CONJOINT
  ENFANT
}

enum StatutReservation {
  CONFIRME
  EMBARQUE
  RATE
  REPORTE
  ANNULE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
}

enum MethodePaiement {
  CASH
  MOBILE_MONEY
  CARTE
}

enum StatutColis {
  EN_ATTENTE
  EXPEDIE
  LIVRE
}

enum TypePassager {
  CLIENT
  EXTERNE
}

enum CategoriePassager {
  ADULTE
  ENFANT
  BEBE
}

enum TypeColis {
  ORDINAIRE
  SPECIAL
}

enum TypeSexe {
  M
  F
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutTrajetDepart {
  PLANIFIE
  OUVERT
  ANNULE
}

enum SourceReservation {
  GUICHET
  EN_LIGNE
}

enum ModeTransport {
  BUS
  AVION
}

enum BranchType {
  AGENCE
  HOTEL
  BOUTIQUE
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchMemberStatus {
  ACTIVE
  REVOKED
}

enum HotelRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_ORDER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARTE
}

enum HotelStayStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum FolioLineKind {
  NIGHT
  FNB
  PRODUCT
  TAX
  OTHER
}

enum HotelOrderStatus {
  BROUILLON
  ENVOYEE
  EN_PREPARATION
  PRETE
  EN_CAISSE
  PAYEE
  LIVREE
  ANNULEE
}


model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  client            Client?
  accounts          Account[]
  invitations       Invitation[]
  members           Member[]
  sessions          Session[]
  reservationDrafts ReservationDraft[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  logo              String?
  createdAt         DateTime
  metadata          String?
  invitations       Invitation[]
  members           Member[]
  organizationroles OrganizationRole[]
  trajets           Trajet[]
  reservationDrafts ReservationDraft[]
  branches          Branch[]

  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String         @id
  organizationId String
  userId         String
  role           String         @default("member")
  createdAt      DateTime
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchMembers  BranchMember[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id              String        @id @default(uuid())
  userId          String        @unique
  dateInscription DateTime      @default(now())
  telephone       String
  societe         String?
  adresse         String?
  prenom          String?
  postnom         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  colis           Colis[]
  passagers       Passager[]
  reservations    Reservation[]
}

model Trajet {
  id              String            @id @default(uuid())
  organizationId  String
  branchId        String?
  villeDepart     String
  villeArrivee    String
  modeTransport   ModeTransport     @default(BUS)
  kilosGratuits   Float
  prixParKilo     Float
  prixBase        Float
  dureeEstimee    Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  trajetProgramme TrajetProgramme[]
  trajetDepart    TrajetDepart[]
  reservations    Reservation[]
  colis           Colis[]

  @@index([organizationId, villeDepart, villeArrivee])
  @@index([organizationId, modeTransport])
  @@index([branchId])
}

model TrajetProgramme {
  id       String @id @default(uuid())
  trajetId String

  jourSemaine JourSemaine 
  heureDepart String 

  actif Boolean @default(true)

  trajet Trajet @relation(fields: [trajetId], references: [id])
}

model TrajetDepart {
  id             String             @id @default(uuid())
  trajetId       String
  dateDepart     DateTime
  heureDepart    String
  statut         StatutTrajetDepart @default(PLANIFIE)
  capacitePlaces Int                @default(50)

  trajet       Trajet        @relation(fields: [trajetId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  colis        Colis[]

  @@index([trajetId, dateDepart])
  @@index([statut])
}


model Passager {
  id            String            @id @default(uuid())
  reservationId String
  codeUnique    String            @unique
  clientId      String?
  nom           String
  prenom        String
  sexe          TypeSexe
  dateNaissance DateTime?
  categorie     CategoriePassager
  prix          Float
  type          TypePassager
  statut        TypePassager
  ordre         Int
  occupePlace   Boolean           @default(true)
  embarqueAt    DateTime?
  createdAt     DateTime          @default(now())
  colis         Colis[]
  client        Client?           @relation(fields: [clientId], references: [id])
  reservation   Reservation       @relation(fields: [reservationId], references: [id])

  @@index([type])
  @@index([reservationId])
  @@index([clientId])
}


model Reservation {
  id               String              @id @default(uuid())
  codeUnique       String              @unique
  clientId         String
  trajetId         String
  trajetDepartId   String
  dateDepart       DateTime
  heureDepart      String
  statut           StatutReservation   @default(CONFIRME)
  source           SourceReservation   @default(GUICHET)
  nombreKilos      Float?
  surplusKilos     Float?
  montantSurplus   Float?
  prixBillet       Float
  prixTotal        Float
  penalite         Float?              @default(0)
  peutReporter     Boolean             @default(true)
  dateLimiteReport DateTime?
  nombrePlaces     Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paiements        Paiement[]
  passagers        Passager[]
  penalites        Penalite[]
  client           Client              @relation(fields: [clientId], references: [id])
  trajet           Trajet              @relation(fields: [trajetId], references: [id])
  trajetDepart     TrajetDepart        @relation(fields: [trajetDepartId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([trajetDepartId])
  @@index([codeUnique])
  @@index([source])
}

model Colis {
  id               String        @id @default(uuid())
  codeUnique       String        @unique
  clientId         String
  trajetId         String
  poids            Float
  kilosGratuits    Float
  surplusKilos     Float
  montantAPayer    Float
  passagerId       String?
  type             TypeColis
  montantFixe      Float?
  commentaire      String?
  destinataireNom  String?
  destinataireTel  String?
  destinataireId   String?
  statut           StatutColis   @default(EN_ATTENTE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  client           Client        @relation(fields: [clientId], references: [id])
  trajet           Trajet        @relation(fields: [trajetId], references: [id])
  trajetDepartId   String?
  trajetDepart     TrajetDepart? @relation(fields: [trajetDepartId], references: [id])
  passager         Passager?     @relation(fields: [passagerId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([codeUnique])
}

model ReservationDraft {
  id             String       @id @default(uuid())
  draftToken     String       @unique @default(uuid())
  organizationId String
  userId         String?
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model Paiement {
  id            String          @id @default(uuid())
  codeUnique    String          @unique
  reservationId String
  montant       Float
  methode       MethodePaiement
  statut        StatutPaiement  @default(EN_ATTENTE)
  reference     String?
  createdAt     DateTime        @default(now())
  reservation   Reservation     @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([codeUnique])
}

model Penalite {
  id            String      @id @default(uuid())
  codeUnique    String      @unique
  reservationId String
  montant       Float
  raison        String
  payee         Boolean     @default(false)
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

/** Point d’exploitation typé (Agence / Hôtel / Boutique). */
model Branch {
  id             String        @id @default(uuid())
  organizationId String
  type           BranchType
  name           String
  code           String
  slug           String?
  status         BranchStatus  @default(ACTIVE)
  address        String?
  city           String?
  phone          String?
  timezone       String        @default("Africa/Kinshasa")
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        BranchMember[]
  trajets        Trajet[]
  hotelRoomTypes HotelRoomType[]
  shopCategories ShopCategory[]
  cashSessions   CashSession[]
  exchangeRates  ExchangeRate[]
  hotelStays     HotelStay[]
  folios         Folio[]
  hotelOrders    HotelOrder[]
  payments       Payment[]
  notifications  BranchNotification[]
  menuItems      HotelMenuItem[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

model BranchMember {
  id        String             @id @default(uuid())
  branchId  String
  memberId  String
  role      String             @default("branch_manager")
  isPrimary Boolean            @default(false)
  status    BranchMemberStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([branchId, memberId])
  @@index([memberId])
  @@index([branchId, status])
}

model HotelRoomType {
  id          String      @id @default(uuid())
  branchId    String
  name        String
  description String?
  capacity    Int         @default(2)
  priceNight  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms       HotelRoom[]

  @@index([branchId])
}

model HotelRoom {
  id         String          @id @default(uuid())
  roomTypeId String
  number     String
  floor      String?
  status     HotelRoomStatus @default(AVAILABLE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  roomType   HotelRoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  stays      HotelStay[]

  @@unique([roomTypeId, number])
  @@index([roomTypeId])
}

model ShopCategory {
  id        String        @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  ShopProduct[]

  @@unique([branchId, name])
  @@index([branchId])
}

model ShopProduct {
  id         String       @id @default(uuid())
  categoryId String
  name       String
  sku        String
  price      Float
  stockQty   Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   ShopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, sku])
  @@index([categoryId])
}

/** Taux de change par branche (ex. USD → CDF). */
model ExchangeRate {
  id        String   @id @default(uuid())
  branchId  String
  fromCurrency String @default("USD")
  toCurrency   String @default("CDF")
  rate      Float
  validFrom DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, validFrom])
}

model CashSession {
  id           String            @id @default(uuid())
  branchId     String
  openedByUserId String
  closedByUserId String?
  status       CashSessionStatus @default(OPEN)
  openingFloat Float             @default(0)
  closingCash  Float?
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([branchId, status])
}

model HotelStay {
  id           String          @id @default(uuid())
  branchId     String
  roomId       String
  guestName    String
  guestPhone   String?
  guestEmail   String?
  checkInDate  DateTime        @db.Date
  checkOutDate DateTime        @db.Date
  status       HotelStayStatus @default(RESERVED)
  adults       Int             @default(1)
  notes        String?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room         HotelRoom       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  folio        Folio?
  orders       HotelOrder[]

  @@index([branchId, checkInDate, checkOutDate])
  @@index([roomId, status])
}

model Folio {
  id        String      @id @default(uuid())
  branchId  String
  stayId    String?     @unique
  label     String?
  closed    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay      HotelStay?  @relation(fields: [stayId], references: [id], onDelete: SetNull)
  lines     FolioLine[]
  payments  Payment[]
  orders    HotelOrder[]

  @@index([branchId, closed])
}

model FolioLine {
  id          String        @id @default(uuid())
  folioId     String
  kind        FolioLineKind @default(OTHER)
  description String
  quantity    Float         @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime      @default(now())
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

model Payment {
  id               String        @id @default(uuid())
  branchId         String
  cashSessionId    String?
  folioId          String?
  orderId          String?
  receiptNumber    String
  method           PaymentMethod @default(CASH)
  amountCdf        Float
  amountForeign    Float?
  foreignCurrency  String?
  exchangeRateUsed Float?
  paidAt           DateTime      @default(now())
  cashierUserId    String
  note             String?
  createdAt        DateTime      @default(now())
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  folio            Folio?        @relation(fields: [folioId], references: [id], onDelete: SetNull)
  order            HotelOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([branchId, receiptNumber])
  @@index([branchId, paidAt])
  @@index([folioId])
  @@index([orderId])
}

/** Catalogue F&B / vente rapide hôtel. */
model HotelMenuItem {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  category     String   @default("Divers")
  price        Float
  needsKitchen Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItems   HotelOrderItem[]

  @@index([branchId, active])
}

model HotelOrder {
  id          String           @id @default(uuid())
  branchId    String
  stayId      String?
  folioId     String?
  tableLabel  String?
  status      HotelOrderStatus @default(BROUILLON)
  serverNote  String?
  createdByUserId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sentAt      DateTime?
  readyAt     DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay        HotelStay?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  folio       Folio?           @relation(fields: [folioId], references: [id], onDelete: SetNull)
  items       HotelOrderItem[]
  payments    Payment[]

  @@index([branchId, status])
}

model HotelOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  quantity   Int           @default(1)
  unitPrice  Float
  amount     Float
  needsKitchen Boolean     @default(true)
  order      HotelOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   HotelMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model BranchNotification {
  id        String   @id @default(uuid())
  branchId  String
  title     String
  body      String
  kind      String   @default("info")
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

