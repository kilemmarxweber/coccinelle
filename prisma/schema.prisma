
generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum RoleFamille {
  CHEF
  CONJOINT
  ENFANT
}

enum StatutReservation {
  CONFIRME
  EMBARQUE
  RATE
  REPORTE
  ANNULE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
}

enum MethodePaiement {
  CASH
  MOBILE_MONEY
  CARTE
}

enum StatutColis {
  EN_ATTENTE
  EXPEDIE
  LIVRE
}

enum TypePassager {
  CLIENT
  EXTERNE
}

enum CategoriePassager {
  ADULTE
  ENFANT
  BEBE
}

enum TypeColis {
  ORDINAIRE
  SPECIAL
}

enum TypeSexe {
  M
  F
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutTrajetDepart {
  PLANIFIE
  OUVERT
  ANNULE
}

enum SourceReservation {
  GUICHET
  EN_LIGNE
}

enum ModeTransport {
  BUS
  AVION
  BATEAU
}

enum BranchType {
  AGENCE
  HOTEL
  BOUTIQUE
  /// F&B seul (sans hébergement) — routes module `hotel/*` + flags.
  RESTAURANT
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchMemberStatus {
  ACTIVE
  REVOKED
}

enum HotelRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_ORDER
}

enum ShopProductKind {
  ARTICLE
  PLAT
}

enum ShopSaleStatus {
  BROUILLON
  EN_ATTENTE
  ENCAISSEE
  ANNULEE
}

enum ShopStockMovementKind {
  ENTREE
  SORTIE
  AJUSTEMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARTE
}

enum HotelStayStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum FolioLineKind {
  NIGHT
  STAY_FLAT
  STAY_OVERTIME
  FNB
  PRODUCT
  TAX
  OTHER
  /// Caution / dépôt (montant négatif = crédit client)
  DEPOSIT
}

enum StayBillingMode {
  NIGHTLY
  FLAT
}

/// Chambre d’hébergement vs salle de réunion (même inventaire / réservation)
enum HotelSpaceKind {
  ROOM
  MEETING
}

enum HotelOrderStatus {
  BROUILLON
  ENVOYEE
  EN_PREPARATION
  PRETE
  EN_CAISSE
  PAYEE
  LIVREE
  ANNULEE
}

enum PurchaseOrderStatus {
  EN_ATTENTE
  FONDS_SORTIS
  VALIDE
  ANNULE
}


model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  client            Client?
  accounts          Account[]
  invitations       Invitation[]
  members           Member[]
  sessions          Session[]
  reservationDrafts ReservationDraft[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  logo              String?
  createdAt         DateTime
  metadata          String?
  invitations       Invitation[]
  members           Member[]
  organizationroles OrganizationRole[]
  trajets           Trajet[]
  reservationDrafts ReservationDraft[]
  branches          Branch[]

  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String         @id
  organizationId String
  userId         String
  role           String         @default("member")
  createdAt      DateTime
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchMembers  BranchMember[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id              String        @id @default(uuid())
  userId          String        @unique
  dateInscription DateTime      @default(now())
  telephone       String
  societe         String?
  adresse         String?
  prenom          String?
  postnom         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  colis           Colis[]
  passagers       Passager[]
  reservations    Reservation[]
}

model Trajet {
  id              String            @id @default(uuid())
  organizationId  String
  branchId        String?
  villeDepart     String
  villeArrivee    String
  modeTransport   ModeTransport     @default(BUS)
  kilosGratuits   Float
  prixParKilo     Float
  prixBase        Float
  dureeEstimee    Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  trajetProgramme TrajetProgramme[]
  trajetDepart    TrajetDepart[]
  reservations    Reservation[]
  colis           Colis[]

  @@index([organizationId, villeDepart, villeArrivee])
  @@index([organizationId, modeTransport])
  @@index([branchId])
}

model TrajetProgramme {
  id       String @id @default(uuid())
  trajetId String

  jourSemaine JourSemaine 
  heureDepart String 

  actif Boolean @default(true)

  trajet Trajet @relation(fields: [trajetId], references: [id])
}

model TrajetDepart {
  id             String             @id @default(uuid())
  trajetId       String
  dateDepart     DateTime
  heureDepart    String
  statut         StatutTrajetDepart @default(PLANIFIE)
  capacitePlaces Int                @default(50)

  trajet       Trajet        @relation(fields: [trajetId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  colis        Colis[]

  @@index([trajetId, dateDepart])
  @@index([statut])
}


model Passager {
  id            String            @id @default(uuid())
  reservationId String
  codeUnique    String            @unique
  clientId      String?
  nom           String
  prenom        String
  sexe          TypeSexe
  dateNaissance DateTime?
  categorie     CategoriePassager
  prix          Float
  type          TypePassager
  statut        TypePassager
  ordre         Int
  occupePlace   Boolean           @default(true)
  embarqueAt    DateTime?
  createdAt     DateTime          @default(now())
  colis         Colis[]
  client        Client?           @relation(fields: [clientId], references: [id])
  reservation   Reservation       @relation(fields: [reservationId], references: [id])

  @@index([type])
  @@index([reservationId])
  @@index([clientId])
}


model Reservation {
  id               String              @id @default(uuid())
  codeUnique       String              @unique
  clientId         String
  trajetId         String
  trajetDepartId   String
  dateDepart       DateTime
  heureDepart      String
  statut           StatutReservation   @default(CONFIRME)
  source           SourceReservation   @default(GUICHET)
  nombreKilos      Float?
  surplusKilos     Float?
  montantSurplus   Float?
  prixBillet       Float
  prixTotal        Float
  penalite         Float?              @default(0)
  peutReporter     Boolean             @default(true)
  dateLimiteReport DateTime?
  nombrePlaces     Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paiements        Paiement[]
  passagers        Passager[]
  penalites        Penalite[]
  client           Client              @relation(fields: [clientId], references: [id])
  trajet           Trajet              @relation(fields: [trajetId], references: [id])
  trajetDepart     TrajetDepart        @relation(fields: [trajetDepartId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([trajetDepartId])
  @@index([codeUnique])
  @@index([source])
}

model Colis {
  id               String        @id @default(uuid())
  codeUnique       String        @unique
  clientId         String
  trajetId         String
  poids            Float
  kilosGratuits    Float
  surplusKilos     Float
  montantAPayer    Float
  passagerId       String?
  type             TypeColis
  montantFixe      Float?
  commentaire      String?
  destinataireNom  String?
  destinataireTel  String?
  destinataireId   String?
  statut           StatutColis   @default(EN_ATTENTE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  client           Client        @relation(fields: [clientId], references: [id])
  trajet           Trajet        @relation(fields: [trajetId], references: [id])
  trajetDepartId   String?
  trajetDepart     TrajetDepart? @relation(fields: [trajetDepartId], references: [id])
  passager         Passager?     @relation(fields: [passagerId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([codeUnique])
}

model ReservationDraft {
  id             String       @id @default(uuid())
  draftToken     String       @unique @default(uuid())
  organizationId String
  userId         String?
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model Paiement {
  id            String          @id @default(uuid())
  codeUnique    String          @unique
  reservationId String
  montant       Float
  methode       MethodePaiement
  statut        StatutPaiement  @default(EN_ATTENTE)
  reference     String?
  createdAt     DateTime        @default(now())
  reservation   Reservation     @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([codeUnique])
}

model Penalite {
  id            String      @id @default(uuid())
  codeUnique    String      @unique
  reservationId String
  montant       Float
  raison        String
  payee         Boolean     @default(false)
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

/** Point d’exploitation typé (Agence / Hôtel / Boutique / Restaurant). */
model Branch {
  id             String        @id @default(uuid())
  organizationId String
  type           BranchType
  name           String
  code           String
  slug           String?
  status         BranchStatus  @default(ACTIVE)
  /// Hébergement : chambres + séjours (HOTEL avec ou sans resto).
  hasStays       Boolean       @default(false)
  /// F&B : restauration, cuisine, produits vendus (HOTEL et/ou RESTAURANT).
  hasRestaurant  Boolean       @default(false)
  /// Agence voyage : modes de transport autorisés.
  hasAvion       Boolean       @default(false)
  hasBus         Boolean       @default(false)
  hasBateau      Boolean       @default(false)
  /// Boutique : verticales métier.
  hasPharmacie   Boolean       @default(false)
  /// Boutique générale (commerce).
  hasShop        Boolean       @default(false)
  hasAlimentation Boolean      @default(false)
  /// Logo / image de la branche (URL ou data URL), optionnel.
  imageUrl       String?
  address        String?
  city           String?
  phone          String?
  email          String?
  timezone       String        @default("Africa/Kinshasa")
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        BranchMember[]
  trajets        Trajet[]
  hotelRoomTypes HotelRoomType[]
  shopCategories ShopCategory[]
  shopProducts   ShopProduct[]
  shopSales      ShopSale[]
  shopStockMovements ShopStockMovement[]
  cashSessions   CashSession[]
  exchangeRates  ExchangeRate[]
  hotelStays     HotelStay[]
  folios         Folio[]
  hotelOrders    HotelOrder[]
  payments       Payment[]
  notifications  BranchNotification[]
  menuItems      HotelMenuItem[]
  stockMovements HotelStockMovement[]
  purchaseOrders PurchaseOrder[]
  expenses       BranchExpense[]
  serviceStockSessions ServiceStockSession[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

model BranchMember {
  id        String             @id @default(uuid())
  branchId  String
  memberId  String
  role      String             @default("branch_manager")
  isPrimary Boolean            @default(false)
  status    BranchMemberStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([branchId, memberId])
  @@index([memberId])
  @@index([branchId, status])
}

model HotelRoomType {
  id          String         @id @default(uuid())
  branchId    String
  name        String
  description String?
  capacity    Int            @default(2)
  /// Places simples (salles de réunion) — optionnel
  seatsStandard Int?
  /// Places VIP (salles de réunion) — optionnel
  seatsVip      Int?
  priceNight  Float
  /// ROOM = chambre · MEETING = salle de réunion
  kind        HotelSpaceKind @default(ROOM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms       HotelRoom[]

  @@index([branchId])
  @@index([branchId, kind])
}

model HotelRoom {
  id         String          @id @default(uuid())
  roomTypeId String
  number     String
  floor      String?
  status     HotelRoomStatus @default(AVAILABLE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  roomType   HotelRoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  stays      HotelStay[]

  @@unique([roomTypeId, number])
  @@index([roomTypeId])
}

model ShopCategory {
  id        String        @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  ShopProduct[]

  @@unique([branchId, name])
  @@index([branchId])
}

model ShopProduct {
  id           String          @id @default(uuid())
  /// Dénormalisé depuis la catégorie.
  branchId     String
  categoryId   String
  name         String
  sku          String
  kind         ShopProductKind @default(ARTICLE)
  price        Float
  /// Prix promo si `promoActive`.
  promoPrice   Float?
  promoActive  Boolean         @default(false)
  promoLabel   String?
  promoStartsAt DateTime?
  promoEndsAt  DateTime?
  stockQty     Int             @default(0)
  barcode      String?
  imageUrl     String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     ShopCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  saleItems    ShopSaleItem[]
  stockMovements ShopStockMovement[]

  @@unique([categoryId, sku])
  @@unique([branchId, barcode])
  @@index([branchId, active])
  @@index([branchId, kind])
  @@index([categoryId])
}

model ShopSale {
  id             String         @id @default(uuid())
  branchId       String
  cashSessionId  String?
  status         ShopSaleStatus @default(BROUILLON)
  ticketNumber   String
  holdLabel      String?
  clientLabel    String?
  clientPhone    String?
  isAnonymous    Boolean        @default(true)
  anonymousCode  String?
  totalAmount    Float          @default(0)
  cashierUserId  String?
  heldAt         DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items          ShopSaleItem[]
  payments       Payment[]
  stockMovements ShopStockMovement[]

  @@unique([branchId, ticketNumber])
  @@index([branchId, status])
  @@index([branchId, createdAt])
}

model ShopSaleItem {
  id           String          @id @default(uuid())
  saleId       String
  productId    String?
  name         String
  kind         ShopProductKind @default(ARTICLE)
  quantity     Int             @default(1)
  unitPrice    Float
  catalogPrice Float?
  wasPromo     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  sale         ShopSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      ShopProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model ShopStockMovement {
  id        String                 @id @default(uuid())
  branchId  String
  productId String
  saleId    String?
  kind      ShopStockMovementKind
  quantity  Int
  note      String?
  createdByUserId String?
  createdAt DateTime               @default(now())
  branch    Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   ShopProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      ShopSale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([productId])
  @@index([saleId])
}

/** Taux de change par branche (ex. USD → CDF). */
model ExchangeRate {
  id        String   @id @default(uuid())
  branchId  String
  fromCurrency String @default("USD")
  toCurrency   String @default("CDF")
  rate      Float
  validFrom DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, validFrom])
}

model CashSession {
  id           String            @id @default(uuid())
  branchId     String
  openedByUserId String
  closedByUserId String?
  status       CashSessionStatus @default(OPEN)
  openingFloat Float             @default(0)
  closingCash  Float?
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([branchId, status])
}

model HotelStay {
  id                 String          @id @default(uuid())
  branchId           String
  roomId             String
  guestName          String
  guestPhone         String?
  guestEmail         String?
  checkInDate        DateTime        @db.Date
  checkOutDate       DateTime        @db.Date
  status             HotelStayStatus @default(RESERVED)
  adults             Int             @default(1)
  notes              String?
  /// NIGHTLY = nuits × tarif · FLAT = forfait / au temps
  billingMode        StayBillingMode @default(NIGHTLY)
  /// Snapshot du priceNight catalogue à la création
  catalogUnitPrice   Float           @default(0)
  /// Prix / nuit négocié (NIGHTLY) ; null = catalogue
  unitPriceApplied   Float?
  /// Montant forfait (FLAT)
  flatAmount         Float?
  /// Durée indicative en heures (FLAT)
  plannedHours       Int?
  /// Motif de négociation / forfait
  rateNote           String?
  /// Caution consommation attendue (salle) — saisie manuelle
  depositAmountExpected Float?
  depositCollectedAt DateTime?
  negotiatedByUserId String?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room               HotelRoom       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  folio              Folio?
  orders             HotelOrder[]

  @@index([branchId, checkInDate, checkOutDate])
  @@index([roomId, status])
}

model Folio {
  id        String      @id @default(uuid())
  branchId  String
  stayId    String?     @unique
  label     String?
  closed    Boolean     @default(false)
  /// Mis en file d’attente caisse (check-out avec solde à régler)
  checkoutQueuedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay      HotelStay?  @relation(fields: [stayId], references: [id], onDelete: SetNull)
  lines     FolioLine[]
  payments  Payment[]
  orders    HotelOrder[]

  @@index([branchId, closed])
  @@index([branchId, checkoutQueuedAt])
}

model FolioLine {
  id          String        @id @default(uuid())
  folioId     String
  kind        FolioLineKind @default(OTHER)
  description String
  quantity    Float         @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime      @default(now())
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

model Payment {
  id               String        @id @default(uuid())
  branchId         String
  cashSessionId    String?
  folioId          String?
  orderId          String?
  shopSaleId       String?
  purchaseOrderId  String?
  expenseId        String?       @unique
  receiptNumber    String
  method           PaymentMethod @default(CASH)
  amountCdf        Float
  amountForeign    Float?
  foreignCurrency  String?
  exchangeRateUsed Float?
  paidAt           DateTime      @default(now())
  cashierUserId    String
  note             String?
  createdAt        DateTime      @default(now())
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  folio            Folio?        @relation(fields: [folioId], references: [id], onDelete: SetNull)
  order            HotelOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shopSale         ShopSale?     @relation(fields: [shopSaleId], references: [id], onDelete: SetNull)
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  expense          BranchExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([branchId, receiptNumber])
  @@index([branchId, paidAt])
  @@index([folioId])
  @@index([orderId])
  @@index([shopSaleId])
  @@index([purchaseOrderId])
}

/** Catalogue F&B / vente rapide / consommables hôtel. */
model HotelMenuItem {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  category     String   @default("Divers")
  /// Prix de vente (optionnel / 0 pour les consommables).
  price        Float    @default(0)
  /// Photo produit (URL ou data URL).
  imageUrl     String?
  /// Quantité en dépôt (magasin / congélateur) — pas le float vendeur.
  stockQty     Int      @default(50)
  /// Code-barres (EAN / Code128 / code interne). Unique par branche.
  barcode      String?
  /// Consommable : non vendu (invisible resto / vente rapide).
  isConsumable Boolean  @default(false)
  /// Provenance (consommables, optionnel).
  provenance   String?
  /// Fournisseur (consommables, optionnel).
  supplierName String?
  needsKitchen Boolean  @default(true)
  /// Zone dépôt : MAGASIN | CONGELATEUR
  storageZone  String   @default("MAGASIN")
  active       Boolean  @default(true)
  /// Utilisateur (membre branche) ayant créé le produit.
  createdByUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItems   HotelOrderItem[]
  stockMovements HotelStockMovement[]
  serviceStockLines ServiceStockLine[]
  serviceStockTopUps ServiceStockTopUp[]

  @@unique([branchId, barcode])
  @@index([branchId, active])
  @@index([branchId, isConsumable])
  @@index([branchId, createdByUserId])
  @@index([branchId, storageZone])
}

/// Entrées (livraison fournisseur) / sorties (consommation) de stock.
model HotelStockMovement {
  id              String   @id @default(uuid())
  branchId        String
  menuItemId      String
  /// ENTREE | SORTIE
  kind            String
  quantity        Int
  /// Stock avant le mouvement
  stockBefore     Int      @default(0)
  /// Stock après le mouvement (reste)
  stockAfter      Int      @default(0)
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem        HotelMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
  @@index([menuItemId, createdAt])
}

/** Session stock service (float vendeur) — ouverture / clôture signées. */
model ServiceStockSession {
  id                       String   @id @default(uuid())
  branchId                 String
  number                   String
  /// DRAFT | OPEN | CLOSING | CLOSED
  status                   String   @default("DRAFT")
  vendorUserId             String
  vendorDisplayName        String
  openedByUserId           String
  closedByManagerUserId    String?
  openedAt                 DateTime @default(now())
  closedAt                 DateTime?
  openingConfirmedAt       DateTime?
  openingDocumentPrintedAt DateTime?
  closingDocumentPrintedAt DateTime?
  /// RETURN_DEPOT | HANDOVER — disposition du restant à la clôture
  closeDisposition         String?
  /// Session précédente dont le float a été hérité (transmission)
  inheritedFromSessionId   String?
  /// Rempli quand le float HANDOVER a été repris par une nouvelle session
  handoverClaimedBySessionId String?
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  branch                   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines                    ServiceStockLine[]
  topUps                   ServiceStockTopUp[]

  @@unique([branchId, number])
  @@index([branchId, status])
  @@index([branchId, openedAt])
  @@index([branchId, closeDisposition, handoverClaimedBySessionId])
}

model ServiceStockLine {
  id                 String              @id @default(uuid())
  sessionId          String
  menuItemId         String
  qtyAttributed      Int                 @default(0)
  qtyOpeningCounted  Int?
  qtySold            Int                 @default(0)
  qtyClosingCounted  Int?
  qtyReturnedToDepot Int                 @default(0)
  qtyLoss            Int                 @default(0)
  unitPriceUsd       Float               @default(0)
  /// MAGASIN | CONGELATEUR
  sourceZone         String              @default("MAGASIN")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  session            ServiceStockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem           HotelMenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, menuItemId])
  @@index([menuItemId])
}

model ServiceStockTopUp {
  id              String              @id @default(uuid())
  sessionId       String
  menuItemId      String
  quantity        Int
  /// MAGASIN | CONGELATEUR
  sourceZone      String              @default("MAGASIN")
  note            String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  session         ServiceStockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem        HotelMenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([menuItemId])
}

model HotelOrder {
  id          String           @id @default(uuid())
  branchId    String
  stayId      String?
  folioId     String?
  tableLabel  String?
  status      HotelOrderStatus @default(BROUILLON)
  /// COMPTANT | NOTE_CHAMBRE — règlement immédiat vs report sur note de chambre
  settlementMode String        @default("COMPTANT")
  /// Quand les lignes F&B ont été postées sur le folio (mode NOTE_CHAMBRE)
  postedToFolioAt DateTime?
  serverNote  String?
  createdByUserId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sentAt      DateTime?
  /// Début de préparation cuisine
  prepStartedAt DateTime?
  /// Cuisinier qui a démarré / pris la préparation
  preparedByUserId String?
  /// Durée estimée annoncée par la cuisine (minutes)
  estimatedMinutes Int?
  readyAt     DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay        HotelStay?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  folio       Folio?           @relation(fields: [folioId], references: [id], onDelete: SetNull)
  items       HotelOrderItem[]
  payments    Payment[]

  @@index([branchId, status])
  @@index([branchId, settlementMode])
}

model HotelOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  quantity   Int           @default(1)
  unitPrice  Float
  amount     Float
  needsKitchen Boolean     @default(true)
  order      HotelOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   HotelMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model BranchNotification {
  id        String   @id @default(uuid())
  branchId  String
  title     String
  body      String
  kind      String   @default("info")
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

/** Bon de commande fournisseur — lignes + sortie caisse à la validation. */
model PurchaseOrder {
  id                String              @id @default(uuid())
  branchId          String
  number            String
  status            PurchaseOrderStatus @default(EN_ATTENTE)
  supplierName      String?
  note              String?
  /// Total demandé (USD) au moment de la création / dernière édition.
  totalAmountUsd    Float               @default(0)
  /// Fonds sortis de caisse (USD) avant / pendant validation.
  fundsReleasedUsd  Float               @default(0)
  /// Total validé reçu (USD).
  validatedAmountUsd Float?
  createdByUserId   String
  validatedByUserId String?
  validatedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items             PurchaseOrderItem[]
  payments          Payment[]

  @@unique([branchId, number])
  @@index([branchId, status])
  @@index([branchId, createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  /// Nom saisi (peut créer le produit à la validation).
  name            String
  /// Catégorie catalogue (hôtel string / boutique nom de catégorie).
  category        String        @default("Divers")
  quantity        Int           @default(1)
  /// Quantité réellement reçue (null = pas encore validé).
  receivedQty     Int?
  unitPriceUsd    Float
  lineTotalUsd    Float
  /// Lien catalogue boutique (optionnel).
  shopProductId   String?
  /// Lien catalogue hôtel (optionnel).
  menuItemId      String?
  /// Produit inexistant au moment de la saisie → à créer à la validation.
  createProduct   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

/** Sortie / entrée de caisse (dépense, banque, remise ou prêt propriétaire). */
model BranchExpense {
  id              String   @id @default(uuid())
  branchId        String
  /// Réf. document : DEP-00001 / DBQ-00001 / RPR-00001
  number          String
  /// DEPENSE | DEPOT_BANQUE | REMISE_PROPRIETAIRE | PRET_PROPRIETAIRE
  kind            String   @default("DEPENSE")
  label           String
  category        String   @default("Divers")
  /// Banque, propriétaire, ou tiers (pour le document de signature).
  beneficiary     String?
  /// Montant en USD (cohérent avec le reste des montants métier).
  amountUsd       Float
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payment         Payment?

  @@unique([branchId, number])
  @@index([branchId, createdAt])
  @@index([branchId, kind])
}

