
generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum StatutReservation {
  CONFIRME
  EMBARQUE
  RATE
  REPORTE
  ANNULE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
}

enum MethodePaiement {
  CASH
  MOBILE_MONEY
  CARTE
}

enum StatutColis {
  EN_ATTENTE
  EXPEDIE
  LIVRE
}

enum TypePassager {
  CLIENT
  EXTERNE
}

enum CategoriePassager {
  ADULTE
  ENFANT
  BEBE
}

enum TypeColis {
  ORDINAIRE
  SPECIAL
}

enum TypeSexe {
  M
  F
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutTrajetDepart {
  PLANIFIE
  OUVERT
  ANNULE
}

enum SourceReservation {
  GUICHET
  EN_LIGNE
}

enum ModeTransport {
  BUS
  AVION
}

enum BranchType {
  AGENCE
  HOTEL
  BOUTIQUE
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BranchMemberStatus {
  ACTIVE
  REVOKED
}

enum HotelRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_ORDER
}

enum HotelStayStatus {
  BOOKED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
}

enum HotelFolioLineKind {
  NIGHT
  OTHER
}

enum HotelFoodOrderStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum HotelFoodOrderSource {
  STAFF_SUR_PLACE
  CLIENT_ONLINE
}

enum HotelRestaurantTableStatus {
  FREE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum HotelTableReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}


model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  client            Client?
  accounts          Account[]
  invitations       Invitation[]
  members           Member[]
  sessions          Session[]
  reservationDrafts ReservationDraft[]
  hotelStayDrafts   HotelStayDraft[]
  hotelStays        HotelStay[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  logo              String?
  createdAt         DateTime
  metadata          String?
  invitations       Invitation[]
  members           Member[]
  organizationroles OrganizationRole[]
  trajets           Trajet[]
  reservationDrafts ReservationDraft[]
  hotelStayDrafts   HotelStayDraft[]
  branches          Branch[]

  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String         @id
  organizationId String
  userId         String
  role           String         @default("member")
  createdAt      DateTime
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchMembers  BranchMember[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id              String        @id @default(uuid())
  userId          String        @unique
  dateInscription DateTime      @default(now())
  telephone       String
  societe         String?
  adresse         String?
  prenom          String?
  postnom         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  colis              Colis[]
  passagers          Passager[]
  reservations       Reservation[]
  hotelTableReservations HotelTableReservation[]
}

model Trajet {
  id              String            @id @default(uuid())
  organizationId  String
  branchId        String?
  villeDepart     String
  villeArrivee    String
  modeTransport   ModeTransport     @default(BUS)
  kilosGratuits   Float
  prixParKilo     Float
  prixBase        Float
  dureeEstimee    Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  trajetProgramme TrajetProgramme[]
  trajetDepart    TrajetDepart[]
  reservations    Reservation[]
  colis           Colis[]

  @@index([organizationId, villeDepart, villeArrivee])
  @@index([organizationId, modeTransport])
  @@index([branchId])
}

model TrajetProgramme {
  id       String @id @default(uuid())
  trajetId String

  jourSemaine JourSemaine 
  heureDepart String 

  actif Boolean @default(true)

  trajet Trajet @relation(fields: [trajetId], references: [id])
}

model TrajetDepart {
  id             String             @id @default(uuid())
  trajetId       String
  dateDepart     DateTime
  heureDepart    String
  statut         StatutTrajetDepart @default(PLANIFIE)
  capacitePlaces Int                @default(50)

  trajet       Trajet        @relation(fields: [trajetId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  colis        Colis[]

  @@index([trajetId, dateDepart])
  @@index([statut])
}


model Passager {
  id            String            @id @default(uuid())
  reservationId String
  codeUnique    String            @unique
  clientId      String?
  nom           String
  prenom        String
  sexe          TypeSexe
  dateNaissance DateTime?
  categorie     CategoriePassager
  prix          Float
  type          TypePassager
  statut        TypePassager
  ordre         Int
  occupePlace   Boolean           @default(true)
  embarqueAt    DateTime?
  createdAt     DateTime          @default(now())
  colis         Colis[]
  client        Client?           @relation(fields: [clientId], references: [id])
  reservation   Reservation       @relation(fields: [reservationId], references: [id])

  @@index([type])
  @@index([reservationId])
  @@index([clientId])
}


model Reservation {
  id               String              @id @default(uuid())
  codeUnique       String              @unique
  clientId         String
  trajetId         String
  trajetDepartId   String
  dateDepart       DateTime
  heureDepart      String
  statut           StatutReservation   @default(CONFIRME)
  source           SourceReservation   @default(GUICHET)
  nombreKilos      Float?
  surplusKilos     Float?
  montantSurplus   Float?
  prixBillet       Float
  prixTotal        Float
  penalite         Float?              @default(0)
  peutReporter     Boolean             @default(true)
  dateLimiteReport DateTime?
  nombrePlaces     Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paiements        Paiement[]
  passagers        Passager[]
  penalites        Penalite[]
  client           Client              @relation(fields: [clientId], references: [id])
  trajet           Trajet              @relation(fields: [trajetId], references: [id])
  trajetDepart     TrajetDepart        @relation(fields: [trajetDepartId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([trajetDepartId])
  @@index([codeUnique])
  @@index([source])
}

model Colis {
  id               String        @id @default(uuid())
  codeUnique       String        @unique
  clientId         String
  trajetId         String
  poids            Float
  kilosGratuits    Float
  surplusKilos     Float
  montantAPayer    Float
  passagerId       String?
  type             TypeColis
  montantFixe      Float?
  commentaire      String?
  destinataireNom  String?
  destinataireTel  String?
  destinataireId   String?
  statut           StatutColis   @default(EN_ATTENTE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  client           Client        @relation(fields: [clientId], references: [id])
  trajet           Trajet        @relation(fields: [trajetId], references: [id])
  trajetDepartId   String?
  trajetDepart     TrajetDepart? @relation(fields: [trajetDepartId], references: [id])
  passager         Passager?     @relation(fields: [passagerId], references: [id])

  @@index([clientId])
  @@index([trajetId])
  @@index([codeUnique])
}

model ReservationDraft {
  id             String       @id @default(uuid())
  draftToken     String       @unique @default(uuid())
  organizationId String
  userId         String?
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model Paiement {
  id            String          @id @default(uuid())
  codeUnique    String          @unique
  reservationId String
  montant       Float
  methode       MethodePaiement
  statut        StatutPaiement  @default(EN_ATTENTE)
  reference     String?
  createdAt     DateTime        @default(now())
  reservation   Reservation     @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([codeUnique])
}

model Penalite {
  id            String      @id @default(uuid())
  codeUnique    String      @unique
  reservationId String
  montant       Float
  raison        String
  payee         Boolean     @default(false)
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

/** Point d’exploitation typé (Agence / Hôtel / Boutique). */
model Branch {
  id             String        @id @default(uuid())
  organizationId String
  type           BranchType
  name           String
  code           String
  slug           String?
  status         BranchStatus  @default(ACTIVE)
  address        String?
  city           String?
  phone          String?
  timezone       String        @default("Africa/Kinshasa")
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        BranchMember[]
  trajets        Trajet[]
  hotelRoomTypes       HotelRoomType[]
  hotelStays           HotelStay[]
  hotelStayDrafts      HotelStayDraft[]
  hotelMenuCategories  HotelMenuCategory[]
  hotelFoodOrders      HotelFoodOrder[]
  hotelRestaurantTables HotelRestaurantTable[]
  hotelTableReservations HotelTableReservation[]
  hotelPayments        HotelPayment[]
  shopCategories       ShopCategory[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

model BranchMember {
  id        String             @id @default(uuid())
  branchId  String
  memberId  String
  role      String             @default("branch_manager")
  isPrimary Boolean            @default(false)
  status    BranchMemberStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([branchId, memberId])
  @@index([memberId])
  @@index([branchId, status])
}

model HotelRoomType {
  id          String      @id @default(uuid())
  branchId    String
  name        String
  description String?
  capacity    Int         @default(2)
  priceNight  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms       HotelRoom[]
  stays       HotelStay[]

  @@index([branchId])
}

model HotelRoom {
  id         String          @id @default(uuid())
  roomTypeId String
  number     String
  floor      String?
  status     HotelRoomStatus @default(AVAILABLE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  roomType   HotelRoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  stays      HotelStay[]

  @@unique([roomTypeId, number])
  @@index([roomTypeId])
}

model HotelStay {
  id           String          @id @default(uuid())
  codeUnique   String          @unique
  branchId     String
  roomTypeId   String
  roomId       String?
  userId       String?
  guestPrenom  String
  guestNom     String
  guestPhone   String
  checkInDate  DateTime
  checkOutDate DateTime
  status       HotelStayStatus @default(BOOKED)
  priceNight   Float
  totalAmount  Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room         HotelRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  folioLines         HotelFolioLine[]
  foodOrders         HotelFoodOrder[]
  payments           HotelPayment[]
  tableReservations  HotelTableReservation[]

  @@index([branchId, status])
  @@index([branchId, checkInDate])
  @@index([roomId])
  @@index([roomTypeId])
  @@index([userId])
}

/** Brouillon réservation chambre client (peut exister avant auth). */
model HotelStayDraft {
  id             String       @id @default(uuid())
  draftToken     String       @unique @default(uuid())
  organizationId String
  branchId       String
  userId         String?
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([branchId])
  @@index([expiresAt])
}

model HotelFolioLine {
  id        String             @id @default(uuid())
  stayId    String
  label     String
  amount    Float
  kind      HotelFolioLineKind @default(NIGHT)
  createdAt DateTime           @default(now())
  stay      HotelStay          @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
}

model HotelMenuCategory {
  id        String          @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items     HotelMenuItem[]

  @@unique([branchId, name])
  @@index([branchId])
}

model HotelMenuItem {
  id          String            @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Float
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    HotelMenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLines  HotelFoodOrderLine[]

  @@index([categoryId])
}

model HotelRestaurantTable {
  id           String                     @id @default(uuid())
  branchId     String
  number       String
  capacity     Int                        @default(2)
  status       HotelRestaurantTableStatus @default(FREE)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  branch       Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       HotelFoodOrder[]
  reservations HotelTableReservation[]

  @@unique([branchId, number])
  @@index([branchId])
}

/** Réservation de table à heure précise (seule ou avec précommande plats). */
model HotelTableReservation {
  id          String                      @id @default(uuid())
  branchId    String
  tableId     String?
  guestPrenom String
  guestNom    String
  guestPhone  String
  startsAt    DateTime
  covers      Int                         @default(2)
  status      HotelTableReservationStatus @default(CONFIRMED)
  stayId      String?
  clientId    String?
  notes       String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  branch      Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table       HotelRestaurantTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  stay        HotelStay?                  @relation(fields: [stayId], references: [id], onDelete: SetNull)
  client      Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  foodOrders  HotelFoodOrder[]

  @@index([branchId, startsAt])
  @@index([branchId, status])
  @@index([tableId])
  @@index([stayId])
  @@index([clientId])
}

model HotelFoodOrder {
  id                  String                 @id @default(uuid())
  branchId            String
  stayId              String?
  tableId             String?
  tableReservationId  String?
  source              HotelFoodOrderSource   @default(STAFF_SUR_PLACE)
  status              HotelFoodOrderStatus   @default(NEW)
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  branch              Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay                HotelStay?             @relation(fields: [stayId], references: [id], onDelete: SetNull)
  table               HotelRestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableReservation    HotelTableReservation? @relation(fields: [tableReservationId], references: [id], onDelete: SetNull)
  lines               HotelFoodOrderLine[]
  payments            HotelPayment[]

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([stayId])
  @@index([tableId])
  @@index([tableReservationId])
}

/** Encaissement hôtel (séjour / F&B) — distinct du voyage `Paiement`. */
model HotelPayment {
  id          String          @id @default(uuid())
  branchId    String
  stayId      String?
  foodOrderId String?
  amount      Float
  method      MethodePaiement
  status      StatutPaiement  @default(PAYE)
  reference   String?
  createdAt   DateTime        @default(now())
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stay        HotelStay?      @relation(fields: [stayId], references: [id], onDelete: SetNull)
  foodOrder   HotelFoodOrder? @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([stayId])
  @@index([foodOrderId])
  @@index([branchId, createdAt])
}

model HotelFoodOrderLine {
  id         String         @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  unitPrice  Float
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())
  order      HotelFoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   HotelMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model ShopCategory {
  id        String        @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  ShopProduct[]

  @@unique([branchId, name])
  @@index([branchId])
}

model ShopProduct {
  id         String       @id @default(uuid())
  categoryId String
  name       String
  sku        String
  price      Float
  stockQty   Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   ShopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, sku])
  @@index([categoryId])
}

